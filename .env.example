# Copia este archivo como .env y completa lo que necesites. Todo es opcional salvo indicación.

# --- Telegram (nivel 3, se configura al final) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_MODE=changes          # changes = solo alertas | always = listado completo en cada escaneo profundo
NOTIFY_ON_RISE=false
MIN_CHANGE_PCT=3             # ignora cambios menores a 3%
DAILY_SUMMARY_HOUR=9         # resumen diario a las 9:00 (hora Chile)

# --- Publicación del dashboard en GitHub Pages (en la VM de Oracle) ---
GH_TOKEN=                    # token fine-grained con permiso "Contents: read & write" SOLO sobre el repo
GH_REPO=usuario/repositorio
PUBLIC_SITE_URL=https://usuario.github.io/repositorio

# --- Ritmo (segundos) ---
FAST_INTERVAL=120            # ciclo rápido: página 1 de cada tienda
DEEP_INTERVAL=1200           # ciclo profundo: todas las páginas
PUBLISH_INTERVAL=600
EVENT_SPEEDUP=2              # x2 durante CyberDay / Black Friday

# --- Anti-bloqueo ---
DOMAIN_MIN_GAP=4             # segundos mínimos entre peticiones al mismo dominio
RESPECT_ROBOTS=true
BLOCK_BASE_PAUSE=900         # pausa al primer bloqueo (se duplica en cada bloqueo seguido)
BROWSER_FALLBACK=true
PROXY_URL=                   # opcional: http://usuario:clave@host:puerto (proxy propio; nunca proxies públicos gratis)

# --- Análisis ---
GODZILLA_DROP_PCT=40         # 🦖 caída >= 40% en 24 h
PRICE_ERROR_RATIO=0.45       # 💥 precio < 45% de la mediana del mismo modelo en otras tiendas
MIN_HISTORY_HOURS=72         # horas mínimas de historial antes de hablar de "mínimo histórico"
